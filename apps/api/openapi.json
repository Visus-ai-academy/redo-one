{
  "openapi": "3.0.0",
  "paths": {
    "/sessao": {
      "post": {
        "operationId": "SessaoController_entrar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sessão aberta; o token vai no cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroLoginDto"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcessoBloqueadoDto"
                }
              }
            }
          }
        },
        "tags": [
          "identidade"
        ]
      },
      "get": {
        "operationId": "SessaoController_atual",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Quem está logado e o que pode fazer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoAtualDto"
                }
              }
            }
          },
          "401": {
            "description": "Sem sessão válida."
          }
        },
        "tags": [
          "identidade"
        ]
      },
      "delete": {
        "operationId": "SessaoController_sair",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Sessão encerrada e cookie apagado."
          }
        },
        "tags": [
          "identidade"
        ]
      }
    },
    "/papeis": {
      "get": {
        "operationId": "PapeisController_listar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PapelResumoDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "identidade"
        ]
      },
      "post": {
        "operationId": "PapeisController_criar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PapelDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PapelCriadoDto"
                }
              }
            }
          },
          "403": {
            "description": "Concede permissão que quem pede não tem."
          },
          "409": {
            "description": "Nome já usado."
          }
        },
        "tags": [
          "identidade"
        ]
      }
    },
    "/papeis/{id}": {
      "get": {
        "operationId": "PapeisController_obter",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PapelDetalheDto"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "tags": [
          "identidade"
        ]
      },
      "put": {
        "operationId": "PapeisController_atualizar",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PapelDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PapelAtualizadoDto"
                }
              }
            }
          },
          "409": {
            "description": "Nome já usado ou papel do sistema."
          }
        },
        "tags": [
          "identidade"
        ]
      },
      "delete": {
        "operationId": "PapeisController_excluir",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "409": {
            "description": "Papel com usuários ou papel do sistema."
          }
        },
        "tags": [
          "identidade"
        ]
      }
    },
    "/permissoes": {
      "get": {
        "operationId": "PermissoesController_catalogo",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tudo o que um papel pode conceder.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TelaCatalogoDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "identidade"
        ]
      }
    },
    "/senha/recuperacao": {
      "post": {
        "operationId": "SenhaController_solicitarRecuperacao",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecuperacaoSenhaDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Sempre 202, exista a conta ou não: não revela quais e-mails têm cadastro."
          }
        },
        "tags": [
          "identidade"
        ]
      }
    },
    "/senha/link": {
      "post": {
        "operationId": "SenhaController_consultarLink",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaLinkDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfoLinkDto"
                }
              }
            }
          },
          "404": {
            "description": "Link desconhecido, vencido ou já usado."
          }
        },
        "tags": [
          "identidade"
        ]
      }
    },
    "/senha/definir": {
      "post": {
        "operationId": "SenhaController_definir",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefinirSenhaDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Senha gravada e sessão aberta (cookie).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SenhaFracaDto"
                }
              }
            }
          },
          "404": {
            "description": "Link desconhecido, vencido ou já usado."
          }
        },
        "tags": [
          "identidade"
        ]
      }
    }
  },
  "info": {
    "title": "One API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "identificador": {
            "type": "string",
            "description": "E-mail ou CPF (com ou sem pontuação).",
            "example": "nome@empresa.com.br"
          },
          "senha": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "identificador",
          "senha"
        ]
      },
      "UsuarioSessaoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "papelId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "papelId"
        ]
      },
      "SessaoDto": {
        "type": "object",
        "properties": {
          "usuario": {
            "$ref": "#/components/schemas/UsuarioSessaoDto"
          },
          "expiraEm": {
            "format": "date-time",
            "type": "string",
            "description": "Quando a sessão expira se não for usada."
          }
        },
        "required": [
          "usuario",
          "expiraEm"
        ]
      },
      "ErroLoginDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "E-mail, CPF ou senha incorretos."
          }
        },
        "required": [
          "message"
        ]
      },
      "AcessoBloqueadoDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Acesso bloqueado por excesso de tentativas."
          },
          "bloqueadoAte": {
            "type": "string",
            "description": "Quando o login volta a ser aceito."
          }
        },
        "required": [
          "message",
          "bloqueadoAte"
        ]
      },
      "SessaoAtualDto": {
        "type": "object",
        "properties": {
          "usuario": {
            "$ref": "#/components/schemas/UsuarioSessaoDto"
          },
          "acessoTotal": {
            "type": "boolean",
            "description": "Papel Administrador: pode tudo, mesmo sem listar as permissões."
          },
          "permissoes": {
            "example": [
              "faturamento.ver",
              "usuarios.ver"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "usuario",
          "acessoTotal",
          "permissoes"
        ]
      },
      "PapelResumoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "sistema": {
            "type": "boolean",
            "description": "Papel fixo: não se edita nem se exclui."
          },
          "acessoTotal": {
            "type": "boolean"
          },
          "totalUsuarios": {
            "type": "number"
          },
          "totalPermissoes": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "nome",
          "descricao",
          "sistema",
          "acessoTotal",
          "totalUsuarios",
          "totalPermissoes"
        ]
      },
      "PapelDetalheDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "sistema": {
            "type": "boolean"
          },
          "acessoTotal": {
            "type": "boolean"
          },
          "totalUsuarios": {
            "type": "number"
          },
          "permissoes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "nome",
          "descricao",
          "sistema",
          "acessoTotal",
          "totalUsuarios",
          "permissoes"
        ]
      },
      "PapelDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Financeiro",
            "maxLength": 60
          },
          "descricao": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "permissoes": {
            "example": [
              "faturamento.ver",
              "faturamento.competencia.fechar"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "nome",
          "permissoes"
        ]
      },
      "PapelCriadoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "PapelAtualizadoDto": {
        "type": "object",
        "properties": {
          "sessoesEncerradas": {
            "type": "number",
            "description": "Sessões encerradas porque as permissões mudaram."
          }
        },
        "required": [
          "sessoesEncerradas"
        ]
      },
      "AcaoCatalogoDto": {
        "type": "object",
        "properties": {
          "chave": {
            "type": "string",
            "example": "usuarios.desbloquear"
          },
          "rotulo": {
            "type": "string",
            "example": "Desbloquear"
          },
          "sensivel": {
            "type": "boolean"
          }
        },
        "required": [
          "chave",
          "rotulo",
          "sensivel"
        ]
      },
      "TelaCatalogoDto": {
        "type": "object",
        "properties": {
          "tela": {
            "type": "string",
            "example": "usuarios"
          },
          "rotulo": {
            "type": "string",
            "example": "Usuários"
          },
          "area": {
            "type": "string",
            "enum": [
              "Painéis",
              "Operação",
              "Cadastros",
              "Financeiro",
              "Configurações"
            ]
          },
          "acoes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AcaoCatalogoDto"
            }
          }
        },
        "required": [
          "tela",
          "rotulo",
          "area",
          "acoes"
        ]
      },
      "RecuperacaoSenhaDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "nome@empresa.com.br"
          }
        },
        "required": [
          "email"
        ]
      },
      "ConsultaLinkDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "O token do link recebido por e-mail."
          }
        },
        "required": [
          "token"
        ]
      },
      "InfoLinkDto": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "convite",
              "recuperacao"
            ]
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "papel": {
            "type": "string",
            "description": "Nome do papel da conta."
          },
          "convidadoPor": {
            "type": "string",
            "nullable": true,
            "description": "Quem convidou (só no convite)."
          }
        },
        "required": [
          "tipo",
          "nome",
          "email",
          "papel",
          "convidadoPor"
        ]
      },
      "DefinirSenhaDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "O token do link recebido por e-mail."
          },
          "senha": {
            "type": "string",
            "format": "password",
            "description": "Pelo menos 8 caracteres, com letras e números."
          }
        },
        "required": [
          "token",
          "senha"
        ]
      },
      "SenhaFracaDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "problemas": {
            "example": [
              "Use pelo menos 8 caracteres."
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "message",
          "problemas"
        ]
      }
    }
  }
}
