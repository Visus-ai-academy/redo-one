  "info": {
    "title": "One API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "identificador": {
            "type": "string",
            "description": "E-mail ou CPF (com ou sem pontuação).",
            "example": "nome@empresa.com.br"
          },
          "senha": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "identificador",
          "senha"
        ]
      },
      "UsuarioSessaoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "papelId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "papelId"
        ]
      },
      "SessaoDto": {
        "type": "object",
        "properties": {
          "usuario": {
            "$ref": "#/components/schemas/UsuarioSessaoDto"
          },
          "expiraEm": {
            "format": "date-time",
            "type": "string",
            "description": "Quando a sessão expira se não for usada."
          }
        },
        "required": [
          "usuario",
          "expiraEm"
        ]
      },
      "ErroLoginDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "E-mail, CPF ou senha incorretos."
          }
        },
        "required": [
          "message"
        ]
      },
      "AcessoBloqueadoDto": {
        "type": "object",
        "properties": {
