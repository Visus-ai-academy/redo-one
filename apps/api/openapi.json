    "/usuarios": {
      "get": {
        "operationId": "UsuariosController_listar",
        "parameters": [
          {
            "name": "busca",
            "required": false,
            "in": "query",
            "description": "Parte do nome ou do e-mail, ou o CPF.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "papelId",
            "required": false,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "situacao",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ativo",
                "convite_pendente",
                "bloqueado",
                "desativado"
              ]
            }
          },
          {
            "name": "pagina",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "porPagina",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
