PORT=
CORS_ORIGIN=http://localhost:5173
# Endereço do front, para os links dos e-mails (convite, nova senha).
APP_URL=http://localhost:5173
# Em produção, atrás do proxy HTTPS: de quem confiar o X-Forwarded-For (ex.: loopback ou 1).
# Vazio no dev local.
TRUST_PROXY=

# Postgres local (lido pelo docker-compose.yml desta pasta)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
# Mesmos valores acima: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=
# Máximo de conexões do pool da API (padrão 10). Fique abaixo do limite do banco/pooler: o pooler
# do Supabase em modo sessão aceita 15 clientes (EMAXCONNSESSION) e o trabalhador de jobs usa o
# mesmo banco.
DATABASE_POOL_MAX=

# Fila de jobs: "true" sobe o trabalhador junto com a API (no dev e em produção). Sem isso, os
# jobs ficam na fila sem rodar.
JOBS_WORKER=true

# E-mail por SMTP. No dev, o Mailpit do docker-compose (veja os e-mails em http://localhost:8025).
# Em produção, a URL SMTP do provedor (SES, Resend ou Postmark), ex.: smtps://usuario:senha@host:465
SMTP_URL=smtp://localhost:1025
EMAIL_REMETENTE=One <nao-responda@localhost>
# Quem recebe os alertas de falha (ex.: o login da MobileMed parou), e-mails separados por
# vírgula. Vazio = sem alerta, só o log.
ALERTAS_EMAIL=

# Storage compatível com S3 (privado). No dev, o RustFS do docker-compose: S3_ENDPOINT=
# http://localhost:9000, S3_FORCAR_PATH_STYLE=true e chaves inventadas (as mesmas sobem o RustFS).
# Em produção, o endpoint e as chaves do provedor (vazio no S3 da AWS).
S3_ENDPOINT=http://localhost:9000
S3_REGIAO=us-east-1
S3_BUCKET=one
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCAR_PATH_STYLE=true

# Segredo do HMAC que pseudonimiza o paciente nos laudos (mínimo de 32 caracteres). Nunca troque
# depois de importar laudos: a identidade de cada laudo depende dele (gere com
# `openssl rand -hex 32`).
PACIENTE_HMAC_SEGREDO=

# Distribuição: com DISTRIBUICAO_MOBILEMED vazio ou "fake" (padrão), a fila é SINTÉTICA (exames e
# clientes do catálogo, pacientes fictícios) e a atribuição só registra na memória; nada sai do processo.
# Tamanho da fila sem médico (padrão 300), semente do sorteio (padrão 1) e % de exames que falham
# na 1ª tentativa, para exercitar o "retomar" (padrão 0); % de exames que, conferidos ao retomar,
# já ganharam médico por fora do robô (padrão 0); % de exames com médico que ele já abriu (LAUDANDO),
# que o recolhimento não tira (padrão 0). As entregas do robô gravadas no banco contam como
# atribuídas: o exame entregue por rodadas anteriores segue com o médico e pode ser recolhido.
DISTRIBUICAO_FAKE_TAMANHO=
DISTRIBUICAO_FAKE_SEMENTE=
DISTRIBUICAO_FAKE_FALHAS_PCT=
DISTRIBUICAO_FAKE_POR_FORA_PCT=
DISTRIBUICAO_FAKE_ABERTOS_PCT=

# MobileMed de verdade (docs/integracao-mobilemed.md, "Adaptador real"): "real" liga a leitura da
# fila e a ATRIBUIÇÃO DE EXAMES DE VERDADE pelas rotas internas do portal; vazio ou "fake" = a fila
# sintética acima. Só ligue com o aval da operação.
DISTRIBUICAO_MOBILEMED=
# Base do portal-api (padrão https://gateway-sa.mobilemed.com.br/portal-api; só https://).
MOBILEMED_PORTAL_API_URL=
# Conta de serviço do One na MobileMed (obrigatórias com "real"): e-mail, senha e a chave base32
# do autenticador (TOTP), mostrada ao cadastrar o MFA. A API faz o login e renova o token sozinha.
# Uma conta só para este processo: outra sessão na mesma conta derruba esta.
MOBILEMED_USUARIO=
MOBILEMED_SENHA=
MOBILEMED_TOTP_SEGREDO=
# Importação automática dos laudos pelo relatório da MobileMed (docs/integracao-mobilemed.md, 2.8):
# vazio (padrão) = desligada; "fake" = o agendamento e o "Importar agora" funcionam, mas o relatório
# volta vazio (a importação termina com erro, sem mexer nos laudos); "real" = lê a MobileMed com a
# mesma conta de serviço acima (um login só, dividido com a distribuição). O intervalo, o período,
# a janela e o teto ficam em Configurações › Importação de laudos.
INGESTAO_MOBILEMED=
# Base do reports-api (padrão https://gateway-sa.mobilemed.com.br/reports-api; só https://).
MOBILEMED_REPORTS_API_URL=
# Exames por página na leitura da fila (padrão 1000) e o máximo que uma leitura aceita (padrão
# 20000; acima disso, o filtro foi ignorado e a leitura é recusada).
MOBILEMED_PAGINA=
MOBILEMED_MAXIMO_EXAMES=
# Prazo de cada chamada em ms (padrão 90000), chamadas ao mesmo tempo (padrão 1) e anomalias
# seguidas (429, 5xx, sem resposta, resposta fora do formato) que param a atribuição (padrão 2).
MOBILEMED_TIMEOUT_MS=
MOBILEMED_CONCORRENCIA=
MOBILEMED_LIMITE_ANOMALIAS=

# Só para os testes dos repositórios (`*-repositories.test.ts`): um banco separado, que os testes
# migram e limpam (truncate). Sem ela, esses testes ficam como "skipped". Ex.: .../<POSTGRES_DB>_test
TEST_DATABASE_URL=
# Só para o teste do storage: o RustFS do docker-compose (ex.: http://localhost:9000).
TEST_S3_ENDPOINT=

# Só para `pnpm --filter @repo/api migrar:legado`: banco do dashboards-one, aberto só para leitura.
LEGADO_DATABASE_URL=
