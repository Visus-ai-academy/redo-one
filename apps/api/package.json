{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "openapi": "nest build && node dist/openapi/export.js",
    "admin:criar": "nest build && node dist/scripts/criar-admin.js",
    "migrar:legado": "nest build && node dist/scripts/migrar-legado.js",
    "comparar:rodadas-legado": "nest build && JOBS_WORKER=false node dist/scripts/comparar-rodadas-legado.js",
    "mobilemed:mapear-medicos": "nest build && JOBS_WORKER=false node dist/scripts/mapear-medicos-mobilemed.js",
    "storage:preparar": "nest build && node dist/scripts/preparar-storage.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "@node-rs/argon2": "2.2.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "graphile-worker": "0.18.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "read-excel-file": "9.3.14",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@repo/config": "workspace:*",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0",
    "write-excel-file": "4.1.1"
  }
}
