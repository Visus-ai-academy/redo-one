{
  "name": "one",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24.11.0 || ^26.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "check": "biome check --write .",
    "check:ci": "biome ci --error-on-warnings .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@repo/config": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "turbo": "2.11.10"
  }
}
